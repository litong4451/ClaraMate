@page "/"
@using AICompanion.Models
@using AICompanion.Services
@inject ChatStateService ChatState
@implements IDisposable

<div class="chat-container">
    <div class="sidebar">
        <div class="avatar-section">
            <div class="avatar @GetAvatarClass()">
                <div class="avatar-icon">👩</div>
                <div class="avatar-badge @GetBadgeClass()">
                    @if (ChatState.CurrentMode == Mode.Girlfriend)
                    {
                        <span>✨</span>
                    }
                    else
                    {
                        <span>💼</span>
                    }
                </div>
            </div>
            <h2 class="ai-name">@ChatState.AiName</h2>
            <p class="ai-status">@GetModeText()</p>
        </div>

        <div class="quick-actions">
            @if (ChatState.CurrentMode == Mode.Girlfriend)
            {
                <button class="action-btn" @onclick='() => QuickAction("今天过得怎么样？")'>
                    <span>❤️</span> 聊心事
                </button>
                <button class="action-btn" @onclick='() => QuickAction("陪我聊聊天吧~")'>
                    <span>☕</span> 说说话
                </button>
                <button class="action-btn" @onclick='() => QuickAction("你今天想和我聊聊我的一天~")'>
                    <span>💬</span> 分享日常
                </button>
            }
            else
            {
                <button class="action-btn" @onclick='() => QuickAction("帮我安排一下明天的日程")'>
                    <span>📅</span> 日程安排
                </button>
                <button class="action-btn" @onclick='() => QuickAction("我需要一些工作建议")'>
                    <span>📄</span> 工作协助
                </button>
                <button class="action-btn" @onclick='() => QuickAction("帮我列出今天的任务")'>
                    <span>💼</span> 任务管理
                </button>
            }
        </div>

        <div class="mode-section">
            <h3>切换模式</h3>
            <div class="mode-buttons">
                <button class="mode-btn @(ChatState.CurrentMode == Mode.Girlfriend ? "active girlfriend" : "")" 
                        @onclick="() => ChatState.SwitchMode(Mode.Girlfriend)">
                    <span>✨</span> 女友模式
                </button>
                <button class="mode-btn @(ChatState.CurrentMode == Mode.Assistant ? "active assistant" : "")" 
                        @onclick="() => ChatState.SwitchMode(Mode.Assistant)">
                    <span>💼</span> 助理模式
                </button>
            </div>
        </div>

        <div class="spacer"></div>

        <button class="settings-btn" @onclick="ShowSettings">
            <span>⚙️</span> 设置
        </button>
    </div>

    <div class="main-chat">
        <header class="chat-header">
            <div class="header-info">
                <div class="header-avatar @GetHeaderAvatarClass()">
                    <span>👩</span>
                </div>
                <div>
                    <h2>@ChatState.AiName</h2>
                    <p>@GetHeaderModeText()</p>
                </div>
            </div>
            <div class="online-status">
                <span class="online-dot"></span>
                <span>在线</span>
            </div>
        </header>

        <div class="messages-area">
            @foreach (var message in ChatState.Messages)
            {
                <div class="message @(message.IsUser ? "user" : "ai") @GetMessageClass(message)">
                    <div class="message-content">
                        <p>@message.Content</p>
                        <span class="timestamp">@message.Timestamp.ToString("HH:mm")</span>
                    </div>
                </div>
            }
            
            @if (ChatState.IsTyping)
            {
                <div class="message ai">
                    <div class="typing-indicator">
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>
                </div>
            }
        </div>

        <div class="input-area">
            <input type="text" 
                   @bind="inputMessage" 
                   @bind:event="oninput"
                   placeholder="说点什么吧..."
                   @onkeypress="HandleKeyPress"
                   disabled="@(ChatState.IsTyping || ChatState.IsTransitioning)" />
            <button @onclick="SendMessage" 
                    disabled="@(string.IsNullOrWhiteSpace(inputMessage) || ChatState.IsTyping || ChatState.IsTransitioning)">
                <span>➤</span>
            </button>
        </div>
    </div>

    @if (showSettings)
    {
        <div class="settings-overlay" @onclick="HideSettings">
            <div class="settings-panel" @onclick:stopPropagation>
                <h2>设置</h2>
                <div class="setting-group">
                    <label>你的昵称</label>
                    <input type="text" @bind="settingsUserName" />
                </div>
                <div class="setting-group">
                    <label>AI称呼</label>
                    <input type="text" @bind="settingsAiName" />
                </div>
                <div class="setting-actions">
                    <button @onclick="HideSettings">取消</button>
                    <button class="primary" @onclick="SaveSettings">保存</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string inputMessage = "";
    private bool showSettings = false;
    private string settingsUserName = "";
    private string settingsAiName = "";

    protected override void OnInitialized()
    {
        ChatState.StateChanged += StateHasChanged;
        ChatState.Initialize();
        settingsUserName = ChatState.UserName;
        settingsAiName = ChatState.AiName;
    }

    public void Dispose()
    {
        ChatState.StateChanged -= StateHasChanged;
    }

    private async Task SendMessage()
    {
        if (!string.IsNullOrWhiteSpace(inputMessage))
        {
            await ChatState.SendMessage(inputMessage);
            inputMessage = "";
        }
    }

    private async Task QuickAction(string message)
    {
        inputMessage = message;
        await SendMessage();
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessage();
        }
    }

    private void ShowSettings()
    {
        settingsUserName = ChatState.UserName;
        settingsAiName = ChatState.AiName;
        showSettings = true;
    }

    private void HideSettings()
    {
        showSettings = false;
    }

    private void SaveSettings()
    {
        if (!string.IsNullOrWhiteSpace(settingsUserName))
            ChatState.UserName = settingsUserName;
        if (!string.IsNullOrWhiteSpace(settingsAiName))
            ChatState.AiName = settingsAiName;
        showSettings = false;
    }

    private string GetAvatarClass() => ChatState.CurrentMode == Mode.Girlfriend ? "girlfriend" : "assistant";
    private string GetBadgeClass() => ChatState.CurrentMode == Mode.Girlfriend ? "girlfriend" : "assistant";
    private string GetHeaderAvatarClass() => ChatState.CurrentMode == Mode.Girlfriend ? "girlfriend" : "assistant";
    
    private string GetModeText() => ChatState.CurrentMode == Mode.Girlfriend ? "💕 你的专属女友" : "💼 你的工作助理";
    private string GetHeaderModeText() => ChatState.CurrentMode == Mode.Girlfriend ? "💕 你的专属女友" : "💼 你的工作助理";
    
    private string GetMessageClass(Message message) 
    {
        if (message.IsUser) return "";
        return message.Mode == Mode.Girlfriend ? "girlfriend" : "assistant";
    }
}
