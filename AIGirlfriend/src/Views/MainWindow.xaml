<Window x:Class="AIGirlfriend.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AIGirlfriend.ViewModels"
        xmlns:conv="clr-namespace:AIGirlfriend.Converters"
        mc:Ignorable="d"
        Title="AI智能伴侣" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None">
    
    <Window.Resources>
        <conv:BoolToAlignmentConverter x:Key="BoolToAlignmentConverter"/>
        <conv:NotNullOrEmptyConverter x:Key="NotNullOrEmptyConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        
        <LinearGradientBrush x:Key="GirlfriendBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF0F5" Offset="0"/>
            <GradientStop Color="#FFE6E6FA" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AssistantBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF0F8FF" Offset="0"/>
            <GradientStop Color="#FFE6E6FA" Offset="1"/>
        </LinearGradientBrush>
        
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="White" Opacity="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="ModeButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="White"
                                BorderBrush="#DDD"
                                BorderThickness="2"
                                CornerRadius="14"
                                Padding="18,14"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFF0F5" Opacity="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Storyboard x:Key="BounceAnimation">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="-10"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="-5"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.8" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        
        <Storyboard x:Key="PulseAnimation" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="1"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.0" Value="0.5"/>
                <EasingDoubleKeyFrame KeyTime="0:0:2.0" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>

    <Border CornerRadius="24" Background="White">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.2"/>
        </Border.Effect>
        
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" Opacity="0.85" BorderBrush="#EEE" BorderThickness="0,0,1,0" CornerRadius="24,0,0,24">
                <StackPanel Margin="24,20">
                    <StackPanel Margin="0,0,0,20">
                        <Grid Height="140" Margin="0,0,0,16">
                            <Ellipse Width="110" Height="110" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop x:Name="avatarGradient1" Color="#FFD8A7" Offset="0"/>
                                        <GradientStop x:Name="avatarGradient2" Color="#FFC774" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="👩" FontSize="60" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFB6C1" Offset="0"/>
                                        <GradientStop Color="#FFC774" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock x:Name="modeBadge" Text="✨" FontSize="20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20,0,0,10"/>
                        </Grid>
                        
                        <TextBlock x:Name="aiNameText" Text="{Binding AiName}" FontSize="24" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock x:Name="aiStatus" Text="💕 你的专属女友" FontSize="13" Foreground="#FF6B9D" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel x:Name="quickActions" Margin="0,0,0,20">
                        <TextBlock Text="快捷操作" FontSize="14" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,12"/>
                        
                        <Button x:Name="btnQuick1" Content="❤️ 聊心事" Style="{StaticResource ModernButton}" Command="{Binding QuickActionCommand}" CommandParameter="今天过得怎么样？" Margin="0,0,0,8"/>
                        <Button x:Name="btnQuick2" Content="☕ 说说话" Style="{StaticResource ModernButton}" Command="{Binding QuickActionCommand}" CommandParameter="陪我聊聊天吧~" Margin="0,0,0,8"/>
                        <Button x:Name="btnQuick3" Content="💬 分享日常" Style="{StaticResource ModernButton}" Command="{Binding QuickActionCommand}" CommandParameter="你今天想和我聊聊我的一天~" Margin="0,0,0,8"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="切换模式" FontSize="14" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,12"/>
                        
                        <Button x:Name="btnGirlfriend" Content="✨ 女友模式" 
                                Style="{StaticResource ModeButton}" 
                                Command="{Binding SwitchModeCommand}" CommandParameter="Girlfriend" 
                                Margin="0,0,0,8">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF6B9D" Offset="0"/>
                                    <GradientStop Color="#C44569" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <Button.Foreground>White</Button.Foreground>
                        </Button>
                        
                        <Button x:Name="btnAssistant" Content="💼 助理模式" 
                                Style="{StaticResource ModeButton}" 
                                Command="{Binding SwitchModeCommand}" CommandParameter="Assistant" 
                                Margin="0,0,0,8">
                            <Button.Background>White</Button.Background>
                            <Button.Foreground>#666</Button.Foreground>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="设置" FontSize="14" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,12"/>
                        <Button x:Name="btnSettings" Content="⚙️ 个性化设置" Style="{StaticResource ModernButton}" Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="White" Opacity="0.95" CornerRadius="0,24,24,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="24,20" BorderBrush="#EEE" BorderThickness="0,0,0,1" Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Orientation="Horizontal">
                                <Border Width="48" Height="48" CornerRadius="24" Margin="0,0,14,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop x:Name="headerAvatar1" Color="#FFD8A7" Offset="0"/>
                                            <GradientStop x:Name="headerAvatar2" Color="#FFC774" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="👩" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AiName}" FontSize="18" FontWeight="Bold" Foreground="#333"/>
                                    <TextBlock x:Name="headerStatus" Text="💕 你的专属女友" FontSize="13" Foreground="#FF6B9D" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="#4ADE80" Margin="0,0,8,0">
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard Storyboard="{StaticResource PulseAnimation}"/>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <TextBlock Text="在线" FontSize="13" Foreground="#888"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Name="messageScroll">
                        <ItemsControl ItemsSource="{Binding Messages}" Padding="24,16" Name="messageList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Border Margin="0,0,0,16" 
                                                HorizontalAlignment="{Binding IsUser, Converter={StaticResource BoolToAlignmentConverter}}"
                                                MaxWidth="60%">
                                            <Border CornerRadius="20" Padding="18,14">
                                                <Border.Background>
                                                    <MultiBinding>
                                                        <MultiBinding.Converter>
                                                            <conv:BoolToBrushConverter/>
                                                        </MultiBinding.Converter>
                                                        <Binding Path="IsUser"/>
                                                    </MultiBinding>
                                                </Border.Background>
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1"/>
                                                </Border.Effect>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Content}" 
                                                               TextWrapping="Wrap" 
                                                               Foreground="{Binding IsUser, Converter={StaticResource BoolToColorConverter}}"
                                                               FontSize="15" 
                                                               LineHeight="20"/>
                                                    <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm}}" 
                                                               FontSize="11" 
                                                               Foreground="{Binding IsUser, Converter={StaticResource BoolToColorConverter}}" 
                                                               Opacity="0.7" 
                                                               HorizontalAlignment="Right"
                                                               Margin="0,8,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="2" Padding="24,16,24,24" BorderBrush="#EEE" BorderThickness="0,1,0,0" Background="White">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" Background="#F5F5F5" CornerRadius="24" Padding="18,12">
                                <TextBox Text="{Binding InputMessage}" 
                                         BorderThickness="0" 
                                         Background="Transparent"
                                         FontSize="15" 
                                         Padding="0"
                                         VerticalContentAlignment="Center"
                                         VerticalAlignment="Center"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="False"
                                         x:Name="txtInput"
                                         KeyDown="txtInput_KeyDown">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding SendMessageCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </Border>
                            
                            <Button Grid.Column="1" 
                                    Width="50" 
                                    Height="50" 
                                    CornerRadius="25" 
                                    Command="{Binding SendMessageCommand}"
                                    IsEnabled="{Binding InputMessage, Converter={StaticResource NotNullOrEmptyConverter}}">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#667EEA" Offset="0"/>
                                        <GradientStop Color="#764BA2" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <Button.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.25"/>
                                </Button.Effect>
                                <TextBlock Text="➤" FontSize="22" Foreground="White"/>
                            </Button>
                        </Grid>
                    </Border>

                    <Grid x:Name="settingsOverlay" Visibility="{Binding ShowSettings, Converter={StaticResource BoolToVisibilityConverter}}" Background="#33000000">
                        <Border Width="420" Height="Auto" Background="White" CornerRadius="20" Padding="32"
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.3"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="个性化设置" FontSize="24" FontWeight="Bold" Foreground="#333" Margin="0,0,0,24"/>
                                
                                <TextBlock Text="你的昵称" FontSize="14" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,8"/>
                                <TextBox Text="{Binding SettingsUserName}" 
                                         FontSize="15" 
                                         Padding="14" 
                                         BorderBrush="#E0E0E0" 
                                         BorderThickness="2" 
                                         CornerRadius="12"
                                         Margin="0,0,0,16"/>
                                
                                <TextBlock Text="AI称呼" FontSize="14" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,8"/>
                                <TextBox Text="{Binding SettingsAiName}" 
                                         FontSize="15" 
                                         Padding="14" 
                                         BorderBrush="#E0E0E0" 
                                         BorderThickness="2" 
                                         CornerRadius="12"
                                         Margin="0,0,0,24"/>
                                
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="取消" 
                                            Style="{StaticResource ModernButton}" 
                                            Command="{Binding CancelSettingsCommand}"
                                            Margin="0,0,12,0"/>
                                    <Button Content="保存" 
                                            Style="{StaticResource ModernButton}" 
                                            Command="{Binding SaveSettingsCommand}"
                                            Foreground="White">
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#667EEA" Offset="0"/>
                                                <GradientStop Color="#764BA2" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
